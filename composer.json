{
    "name": "trix/vow",
    "description": "Fast, synchronous, strongly typed promises for PHP 8.4",
    "type": "library",
    "license": "MIT",
    "keywords": ["promise", "deferred", "async", "fiber"],
    "authors": [
        {
            "name": "Trix"
        }
    ],
    "require": {
        "php": ">=8.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.0",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-strict-rules": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Vow\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Vow\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --memory-limit=1G"
    },
    "config": {
        "sort-packages": true
    }
}
